rules_version = '2';

// Bait Al Ebdaa app — Firestore security rules.
//
// The project is on the free Spark plan: there are no Cloud Functions, so these rules are
// the only server-side check on what the app writes. They must stay in step with
// FirestoreRequestRepository.toFirestore (lib/core/firebase/firestore_request_repository.dart).
//
// - A signed-in customer (a real account, not a guest identity) may create one request in
//   their own name, in the "submitted" state, with valid fields; and read only their own.
// - Nobody can change or delete a request from the app. Staff work in the Firebase console
//   until a staff tool exists; a "staff" custom claim already grants them read access.
// - Everything else is closed.
//
// Deploy from baitalebdaa_app/:  firebase deploy --only firestore:rules --project <project-id>

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // Sending a request needs a real account (owner decision, 18 Oct 2026), not a silent
    // guest identity, so customers can follow their requests from any phone.
    function hasAccount() {
      return signedIn() && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }

    function isStaff() {
      return signedIn() && request.auth.token.role == 'staff';
    }

    function optionalText(data, key, max) {
      return data[key] == null || (data[key] is string && data[key].size() > 0 && data[key].size() <= max);
    }

    function optionalChoice(data, key, choices) {
      return data[key] == null || data[key] in choices;
    }

    function validContact(c) {
      return c is map
        && c.keys().hasOnly(['name', 'phone', 'email'])
        && c.name is string && c.name.size() > 0 && c.name.size() <= 80
        && c.phone is string && c.phone.matches('^[+][1-9][0-9]{7,14}$')
        && (c.email == null || (c.email is string && c.email.size() <= 254
            && c.email.matches('^[^@ ]+@[^@ ]+[.][^@ ]+$')));
    }

    function validSize(s) {
      return s == null || (s is map && s.keys().hasOnly(['value', 'unit'])
        && s.value is int && s.value > 0 && s.value <= 1000000 && s.unit in ['sqft', 'sqm']);
    }

    function validNewRequest(requestId, d) {
      return d.keys().hasOnly([
          'schemaVersion', 'ownerUid', 'reference', 'status', 'serviceIds', 'propertyType',
          'emirateId', 'area', 'size', 'budgetAed', 'stage', 'consultationType',
          'preferredDate', 'preferredWindow', 'timeFlexible', 'contact', 'note', 'locale',
          'platform', 'createdAt', 'updatedAt'])
        && d.keys().hasAll([
          'schemaVersion', 'ownerUid', 'reference', 'status', 'serviceIds', 'emirateId',
          'consultationType', 'timeFlexible', 'contact', 'locale', 'platform', 'createdAt',
          'updatedAt'])
        && d.schemaVersion == 1
        && d.ownerUid == request.auth.uid
        && d.status == 'submitted'
        && d.reference == 'BAE-' + requestId[0:5]
        && d.serviceIds is list && d.serviceIds.size() >= 1 && d.serviceIds.size() <= 3
        && optionalChoice(d, 'propertyType',
            ['villa', 'townhouse', 'apartment', 'penthouse', 'office', 'restaurant', 'retail', 'commercial', 'other'])
        && d.emirateId in
            ['dubai', 'abu-dhabi', 'sharjah', 'ajman', 'ras-al-khaimah', 'fujairah', 'umm-al-quwain']
        && optionalText(d, 'area', 80)
        && validSize(d['size'])
        && (d.budgetAed == null || (d.budgetAed is int && d.budgetAed > 0 && d.budgetAed <= 100000000))
        && optionalChoice(d, 'stage',
            ['exploring', 'needDesign', 'haveDrawings', 'readyForFitOut', 'renovating', 'joineryOnly', 'other'])
        && d.consultationType in ['phone', 'whatsapp', 'siteSurvey', 'factoryVisit']
        && (d.preferredDate == null
            || (d.preferredDate is string && d.preferredDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')))
        && optionalChoice(d, 'preferredWindow', ['morning', 'afternoon', 'evening'])
        && d.timeFlexible is bool
        && validContact(d.contact)
        && optionalText(d, 'note', 500)
        && d.locale in ['en', 'ar']
        && d.platform is string && d.platform.size() <= 20
        && d.createdAt == request.time
        && d.updatedAt == request.time;
    }

    match /requests/{requestId} {
      allow read: if isStaff() || (signedIn() && resource.data.ownerUid == request.auth.uid);
      allow create: if hasAccount()
        && requestId.matches('^[2-9A-HJKMNP-Z]{20}$')
        && validNewRequest(requestId, request.resource.data);
      allow update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
