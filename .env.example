# Copy to .env.local and fill in real values. All of these are optional — anything
# left unset is simply skipped (no fake tracking IDs or verification codes ship).

# Google Analytics 4 — Admin > Data Streams > your web stream > Measurement ID (G-XXXXXXXXXX)
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Google Search Console — Settings > Ownership verification > HTML tag method,
# copy just the `content="..."` value, not the whole <meta> tag.
GOOGLE_SITE_VERIFICATION=

# Bing Webmaster Tools — Site Settings > verify via "meta tag" option, copy the
# `content="..."` value.
BING_SITE_VERIFICATION=

# Contact form, quote modal, estimator and newsletter emails (src/app/api/contact/route.js)
# all go through Resend — without these three, every submission on the site fails
# with "Email sending is not configured." Get RESEND_API_KEY from resend.com/api-keys.
RESEND_API_KEY=
# Must be an address on a domain verified in Resend (resend.com/domains) — not a
# plain @gmail.com/@baitalebdaa.com address unless that domain is verified there.
CONTACT_FROM_EMAIL=
# Where every form submission is delivered.
CONTACT_TO_EMAIL=info@baitalebdaa.com

# "Ask AI" floating chat widget (src/components/AskAIWidget.jsx, src/app/api/chat/route.js)
# — without this, the widget still renders but every message returns "Chat is
# not configured yet." Get a free key from aistudio.google.com/apikey.
GEMINI_API_KEY=

# Admin panel at /admin and lead capture (src/lib/admin). Without FIREBASE_SERVICE_ACCOUNT,
# form submissions are still emailed but not saved to the panel; without all three, /admin
# shows a setup page.
# Firebase console (project baitalebdaa) > Project settings > Service accounts > Generate
# new private key: paste the whole JSON (or its base64). Keep it secret.
FIREBASE_SERVICE_ACCOUNT=
# Firebase console > Project settings > General > Web API Key.
FIREBASE_WEB_API_KEY=
# Emails allowed into /admin, comma-separated. Each needs an Email/Password account in
# Firebase console > Authentication > Users.
ADMIN_EMAILS=
